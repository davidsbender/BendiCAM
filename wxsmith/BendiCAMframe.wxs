<?xml version="1.0" encoding="utf-8" ?>
<wxsmith>
	<object class="wxFrame" name="BendiCAMFrame">
		<title>BendiCAM</title>
		<size>927,770</size>
		<id_arg>0</id_arg>
		<style>wxDEFAULT_FRAME_STYLE|wxBORDER_DOUBLE</style>
		<handler function="OnClose" entry="EVT_CLOSE" />
		<object class="wxPanel" name="ID_PANEL1" variable="PanelDrawing" member="yes">
			<pos>24,24</pos>
			<size>320,360</size>
			<bg>#FFFFFF</bg>
			<style>wxBORDER_SUNKEN|wxTAB_TRAVERSAL|wxVSCROLL|wxHSCROLL</style>
		</object>
		<object class="wxPanel" name="ID_PANEL2" variable="Panel3D" member="yes">
			<pos>352,24</pos>
			<size>316,360</size>
			<bg>#F5F5FA</bg>
			<style>wxBORDER_SUNKEN|wxTAB_TRAVERSAL</style>
		</object>
		<object class="wxStaticBox" name="ID_STATICBOX3" variable="StaticBoxLayers" member="yes">
			<label>Layers</label>
			<pos>680,24</pos>
			<size>223,170</size>
		</object>
		<object class="wxCheckListBox" name="ID_CHECKLISTBOX1" variable="CheckListBoxLayers" member="yes">
			<pos>692,44</pos>
			<size>199,140</size>
			<handler function="OnCheckListBoxLayersToggled" entry="EVT_CHECKLISTBOX" />
		</object>
		<object class="wxStaticBox" name="ID_STATICBOX4" variable="StaticBoxParts" member="yes">
			<label>Parts</label>
			<pos>680,195</pos>
			<size>223,195</size>
		</object>
		<object class="wxTreeCtrl" name="ID_TREECTRL1" variable="TreeCtrlParts" member="yes">
			<image_list></image_list>
			<tree_items>
				<item>TreeCtrlParts</item>
				<item></item>
			</tree_items>
			<items_text>
				<item2>TreeCtrlParts</item2>
				<item2></item2>
			</items_text>
			<pos>692,212</pos>
			<size>199,48</size>
			<style>wxTR_HAS_BUTTONS|wxTR_LINES_AT_ROOT|wxTR_HIDE_ROOT|wxTR_SINGLE</style>
			<handler function="OnTreeCtrlPartsSelChanged" entry="EVT_TREE_SEL_CHANGED" />
		</object>
		<object class="wxStaticText" name="ID_STATICTEXT1" variable="StaticTextDepth" member="yes">
			<label>Depth (mm):</label>
			<pos>692,266</pos>
		</object>
		<object class="wxTextCtrl" name="ID_TEXTCTRL2" variable="TextCtrlDepth" member="yes">
			<value>5.0</value>
			<pos>768,264</pos>
			<size>123,22</size>
		</object>
		<object class="wxButton" name="ID_BUTTON1" variable="ButtonCreatePart" member="yes">
			<label>Create part</label>
			<pos>692,290</pos>
			<size>96,24</size>
			<handler function="OnButtonCreatePartClick" entry="EVT_BUTTON" />
		</object>
		<object class="wxButton" name="ID_BUTTON2" variable="ButtonAddToPart" member="yes">
			<label>Add to part</label>
			<pos>795,290</pos>
			<size>96,24</size>
			<handler function="OnButtonAddToPartClick" entry="EVT_BUTTON" />
		</object>
		<object class="wxCheckBox" name="ID_CHECKBOX1" variable="CheckBoxClosePolylines" member="yes">
			<label>Close Matching Endpoints</label>
			<checked>1</checked>
			<pos>692,318</pos>
			<size>205,34</size>
			<handler function="OnCheckBoxClosePolylinesClick" entry="EVT_CHECKBOX" />
		</object>
		<object class="wxStaticText" name="ID_STATICTEXT2" variable="StaticTextConnTol" member="yes">
			<label>Matching Tolerance:</label>
			<pos>692,358</pos>
		</object>
		<object class="wxTextCtrl" name="ID_TEXTCTRL3" variable="TextCtrlConnTolerance" member="yes">
			<value>0.1</value>
			<pos>825,356</pos>
			<size>66,22</size>
		</object>
		<object class="wxStaticBox" name="ID_STATICBOX2" variable="StaticBoxStatus" member="yes">
			<label>Status</label>
			<pos>16,664</pos>
			<size>896,96</size>
		</object>
		<object class="wxTextCtrl" name="ID_TEXTCTRL1" variable="TextCtrlStatus" member="yes">
			<value>Running&#x0A;</value>
			<pos>24,680</pos>
			<size>880,64</size>
			<style>wxTE_MULTILINE|wxVSCROLL</style>
		</object>
		<object class="wxStaticBox" name="ID_STATICBOX5" variable="StaticBoxTool" member="yes">
			<label>Tool (Milling Cutter)</label>
			<pos>680,396</pos>
			<size>223,135</size>
		</object>
		<object class="wxStaticText" name="ID_STATICTEXT3" variable="StaticTextToolDiameter" member="yes">
			<label>Diameter (mm):</label>
			<pos>692,416</pos>
		</object>
		<object class="wxTextCtrl" name="ID_TEXTCTRL4" variable="TextCtrlToolDiameter" member="yes">
			<value>2</value>
			<pos>768,414</pos>
			<size>40,22</size>
			<style>wxTE_RIGHT</style>
			<handler function="OnToolOrMaterialSettingChange" entry="EVT_TEXT" />
		</object>
		<object class="wxStaticText" name="ID_STATICTEXT4" variable="StaticTextToolRPM" member="yes">
			<label>RPM (min^-1):</label>
			<pos>815,416</pos>
		</object>
		<object class="wxTextCtrl" name="ID_TEXTCTRL5" variable="TextCtrlToolRPM" member="yes">
			<value>12000</value>
			<pos>880,414</pos>
			<size>40,22</size>
			<style>wxTE_RIGHT</style>
			<handler function="OnToolOrMaterialSettingChange" entry="EVT_TEXT" />
		</object>
		<object class="wxStaticText" name="ID_STATICTEXT5" variable="StaticTextToolFeedXY" member="yes">
			<label>Feed XY (mm/min):</label>
			<pos>692,442</pos>
		</object>
		<object class="wxTextCtrl" name="ID_TEXTCTRL6" variable="TextCtrlToolFeedXY" member="yes">
			<value>500</value>
			<pos>768,440</pos>
			<size>40,22</size>
			<style>wxTE_RIGHT</style>
			<handler function="OnToolOrMaterialSettingChange" entry="EVT_TEXT" />
		</object>
		<object class="wxStaticText" name="ID_STATICTEXT6" variable="StaticTextToolFeedZ" member="yes">
			<label>Feed Z (mm/min):</label>
			<pos>815,442</pos>
		</object>
		<object class="wxTextCtrl" name="ID_TEXTCTRL7" variable="TextCtrlToolFeedZ" member="yes">
			<value>250</value>
			<pos>880,440</pos>
			<size>40,22</size>
			<style>wxTE_RIGHT</style>
			<handler function="OnToolOrMaterialSettingChange" entry="EVT_TEXT" />
		</object>
		<object class="wxStaticText" name="ID_STATICTEXT7" variable="StaticTextToolStepdown" member="yes">
			<label>Stepdown (mm):</label>
			<pos>692,468</pos>
		</object>
		<object class="wxTextCtrl" name="ID_TEXTCTRL8" variable="TextCtrlToolStepdown" member="yes">
			<value>1</value>
			<pos>768,466</pos>
			<size>40,22</size>
			<style>wxTE_RIGHT</style>
			<handler function="OnToolOrMaterialSettingChange" entry="EVT_TEXT" />
		</object>
		<object class="wxStaticText" name="ID_STATICTEXT8" variable="StaticTextToolStepover" member="yes">
			<label>Stepover (%):</label>
			<pos>815,468</pos>
		</object>
		<object class="wxTextCtrl" name="ID_TEXTCTRL9" variable="TextCtrlToolStepover" member="yes">
			<value>70</value>
			<pos>880,466</pos>
			<size>40,22</size>
			<style>wxTE_RIGHT</style>
			<handler function="OnToolOrMaterialSettingChange" entry="EVT_TEXT" />
		</object>
		<object class="wxStaticText" name="ID_STATICTEXT9" variable="StaticTextToolRampAngle" member="yes">
			<label>Ramp Angle (°):</label>
			<pos>692,494</pos>
		</object>
		<object class="wxTextCtrl" name="ID_TEXTCTRL10" variable="TextCtrlToolRampAngle" member="yes">
			<value>20</value>
			<pos>768,492</pos>
			<size>40,22</size>
			<style>wxTE_RIGHT</style>
			<handler function="OnToolOrMaterialSettingChange" entry="EVT_TEXT" />
		</object>
		<object class="wxStaticText" name="ID_STATICTEXT12" variable="StaticTextToolOvercut" member="yes">
			<label>Overcut (%):</label>
			<pos>815,494</pos>
		</object>
		<object class="wxTextCtrl" name="ID_TEXTCTRL13" variable="TextCtrlToolOvercut" member="yes">
			<value>30</value>
			<pos>880,492</pos>
			<size>40,22</size>
			<style>wxTE_RIGHT</style>
			<handler function="OnToolOrMaterialSettingChange" entry="EVT_TEXT" />
		</object>
		<object class="wxStaticBox" name="ID_STATICBOX6" variable="StaticBoxMaterial" member="yes">
			<label>Material &amp; Safety</label>
			<pos>680,537</pos>
			<size>223,50</size>
		</object>
		<object class="wxStaticText" name="ID_STATICTEXT10" variable="StaticTextMatTopHeight" member="yes">
			<label>Top Height (mm):</label>
			<pos>692,555</pos>
		</object>
		<object class="wxTextCtrl" name="ID_TEXTCTRL11" variable="TextCtrlMatTopHeight" member="yes">
			<value>10</value>
			<pos>768,553</pos>
			<size>40,22</size>
			<style>wxTE_RIGHT</style>
			<handler function="OnToolOrMaterialSettingChange" entry="EVT_TEXT" />
		</object>
		<object class="wxStaticText" name="ID_STATICTEXT11" variable="StaticTextSafeZ" member="yes">
			<label>Safe Z (mm):</label>
			<pos>815,555</pos>
		</object>
		<object class="wxTextCtrl" name="ID_TEXTCTRL12" variable="TextCtrlSafeZ" member="yes">
			<value>10</value>
			<pos>880,553</pos>
			<size>40,22</size>
			<style>wxTE_RIGHT</style>
			<handler function="OnToolOrMaterialSettingChange" entry="EVT_TEXT" />
		</object>
		<object class="wxButton" name="ID_BUTTON3" variable="ButtonExportGCode" member="yes">
			<label>Export EdingCNC G-Code...</label>
			<pos>680,595</pos>
			<size>223,28</size>
			<handler function="OnExportGCode" entry="EVT_BUTTON" />
		</object>
		<object class="wxMenuBar" variable="MenuBar1" member="no">
			<object class="wxMenu" variable="Menu1" member="no">
				<label>&amp;File</label>
				<object class="wxMenuItem" name="idMenuOpen" variable="MenuItemOpen" member="no">
					<label>Open CAD Drawing</label>
					<accel>Ctrl-O</accel>
					<help>Open a CAD drawing file</help>
					<handler function="OnOpen" entry="EVT_MENU" />
				</object>
				<object class="wxMenuItem" name="idMenuOpenProject" variable="MenuItemOpenProject" member="no">
					<label>Open BendiCAM Project</label>
					<accel>Ctrl-P</accel>
					<help>Open a BendiCAM project file</help>
					<handler function="OnOpenProject" entry="EVT_MENU" />
				</object>
				<object class="wxMenuItem" name="idMenuSaveProject" variable="MenuItemSaveProject" member="no">
					<label>Save BendiCAM Project</label>
					<accel>Ctrl-S</accel>
					<help>Save current project to file</help>
					<handler function="OnSaveProject" entry="EVT_MENU" />
				</object>
				<object class="wxMenuItem" name="ID_MENUITEM1" variable="MenuItem1" member="no">
					<label>Quit</label>
					<accel>Alt-F4</accel>
					<help>Quit the application</help>
					<handler function="OnQuit" entry="EVT_MENU" />
				</object>
			</object>
			<object class="wxMenu" variable="Menu2" member="no">
				<label>Help</label>
				<object class="wxMenuItem" name="idMenuAbout" variable="MenuItem2" member="no">
					<label>About</label>
					<accel>F1</accel>
					<help>Show info about this application</help>
					<handler function="OnAbout" entry="EVT_MENU" />
				</object>
			</object>
		</object>
		<object class="wxTimer" name="ID_TIMER" variable="Timer" member="yes">
			<interval>200</interval>
			<handler function="OnTimerTrigger" entry="EVT_TIMER" />
		</object>
	</object>
</wxsmith>
